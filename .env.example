# Deutsche Post / DHL API Credentials
DHL_API_KEY=
DHL_API_SECRET=
DHL_PORTOKASSE_LOGIN=
DHL_PORTOKASSE_PASSWORD=
# false = reserve shopOrderId first, lost responses recoverable. true = one-call checkout, Deutsche Post assigns the id, lost response → check manually
DPOST_DIRECT_CHECKOUT=false

# Server-side sender address (optional)
# If set, these become defaults in the UI and can be overridden by user
SENDER_NAME=
SENDER_COMPANY=
SENDER_STREET=
SENDER_CITY=
SENDER_POSTAL_CODE=
SENDER_COUNTRY=DE

# Server-side printer configuration (optional)
# If set, these become defaults in the UI and can be overridden by user
CUPS_URL=
CUPS_PRINTER_NAME=
PAPER_FORMAT_ID=           # numeric DHL format ID (e.g. 176 for A6)
PRINTER_ORIENTATION=portrait
CROP_MARGIN_TOP=5
CROP_MARGIN_RIGHT=5
CROP_MARGIN_BOTTOM=5
CROP_MARGIN_LEFT=5
DISABLE_CROPPING=false
ENABLE_DIRECT_PRINT=false
PAPER_WIDTH_MM=62
PAPER_HEIGHT_MM=100
ENDLESS_ROLL=true

# Server configuration
LANGUAGE=de                # de | en (UI language)
PORT=3000
LOG_LEVEL=info
PDF_STORAGE_PATH=/data/labels
RETENTION_DAYS=60
# Max Portokasse top-up per request (EUR); DHL minimum is 10
TOPUP_MAX_EUR=50
# All top-ups per Berlin day, UI + auto (pending/unknown outcomes count)
TOPUP_DAILY_MAX_EUR=100
STATIC_PATH=/app/public

# Cardmarket email intake (off unless MAIL_SERVER/USERNAME/PASSWORD set).
MAIL_SERVER=
MAIL_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX,Archive  # comma-separated
# Handled CM + DHL confirmation mails → marked read, moved here. Empty = read-only, mailbox untouched
MAIL_ARCHIVE_FOLDER=Archive
MAIL_POLL_SECONDS=120
DISCORD_WEBHOOK_URL=
DISCORD_MESSAGE_ITEMS_LIST=true  # false = order notices without the item lines
CM_DRY_RUN=true            # parse + notify only; false = buy + print
CM_MAX_LABELS_PER_DAY=30
# Email path only, Europe/Berlin. Outside: order queued, bought + printed when the window opens. Empty = 24h
PRINT_WINDOW_WEEKDAY=07:00-21:00
PRINT_WINDOW_WEEKEND=09:00-19:00
# Auto top-up before a CM label when the balance can't cover it. 0 = off; else 10 (DHL min) to TOPUP_MAX_EUR
AUTO_TOPUP_EUR=0
AUTO_TOPUP_DAILY_MAX_EUR=  # default = AUTO_TOPUP_EUR, i.e. one top-up per day
