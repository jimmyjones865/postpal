# Deutsche Post / DHL API Credentials
DHL_API_KEY=
DHL_API_SECRET=
DHL_PORTOKASSE_LOGIN=
DHL_PORTOKASSE_PASSWORD=

# Server-side sender address (optional)
# If set, these become defaults in the UI and can be overridden by user
SENDER_NAME=
SENDER_COMPANY=
SENDER_STREET=
SENDER_CITY=
SENDER_POSTAL_CODE=
SENDER_COUNTRY=DE

# Server-side printer configuration (optional)
# If set, these become defaults in the UI and can be overridden by user
CUPS_URL=
CUPS_PRINTER_NAME=
PAPER_FORMAT_ID=           # numeric DHL format ID (e.g. 176 for A6)
PRINTER_ORIENTATION=portrait
CROP_MARGIN_TOP=5
CROP_MARGIN_RIGHT=5
CROP_MARGIN_BOTTOM=5
CROP_MARGIN_LEFT=5
DISABLE_CROPPING=false
ENABLE_DIRECT_PRINT=false
PAPER_WIDTH_MM=62
PAPER_HEIGHT_MM=100
ENDLESS_ROLL=true

# Server configuration
LANGUAGE=de                # de | en (UI language)
PORT=3000
LOG_LEVEL=info
PDF_STORAGE_PATH=/data/labels
RETENTION_DAYS=60
STATIC_PATH=/app/public
